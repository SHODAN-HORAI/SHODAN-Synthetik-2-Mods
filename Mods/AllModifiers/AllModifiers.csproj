<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AllModifiers</AssemblyName>
    <RootNamespace>AllModifiers</RootNamespace>
    <Version>2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <InteropPath>C:\Program Files (x86)\Steam\steamapps\common\SYNTHETIK 2\BepInEx\interop</InteropPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" PrivateAssets="all" />
    <!-- Game classes, generated by BepInEx on first launch -->
    <Reference Include="Framework"><HintPath>$(InteropPath)\Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Synthetik2"><HintPath>$(InteropPath)\Synthetik2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(InteropPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(InteropPath)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
